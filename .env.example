# KARAG configuration. Copy to .env and adjust. Never commit real secrets.

# ---- Provider selection --------------------------------------------------
# Offline/tests (default): fully deterministic, no network.
KARAG_GENERATOR=fake        # fake | ollama | anthropic | openai
KARAG_EMBEDDER=fake         # fake | ollama | openai | voyage
KARAG_STORE=memory          # memory | sqlite | pgvector
KARAG_EMBED_DIM=256

# ---- OpenAI GPT generator (alt to Claude; same OPENAI_API_KEY) -----------
# KARAG_GENERATOR=openai
# KARAG_OPENAI_MODEL=gpt-5.5   # tools + reasoning on chat/completions, no override
# gpt-5.6 (sol/terra/luna) are reasoning models: to expose tools on
# chat/completions set KARAG_OPENAI_REASONING_EFFORT=none, else use the
# Responses API. gpt-5.5 is the recommended balanced default.
# KARAG_OPENAI_REASONING_EFFORT=
# OPENAI_API_KEY=sk-proj-...
# Pair with an embedder (Claude/OpenAI generators have their own embed paths):
# KARAG_EMBEDDER=openai
# KARAG_OPENAI_EMBED_MODEL=text-embedding-3-large
# KARAG_EMBED_DIM=1024

# openai / voyage embedders (set the matching API key)
# OPENAI_API_KEY=sk-...
# KARAG_OPENAI_EMBED_MODEL=text-embedding-3-large
# VOYAGE_API_KEY=pa-...
# KARAG_VOYAGE_EMBED_MODEL=voyage-3
# sqlite store: file path for persistence (":memory:" = ephemeral)
# KARAG_SQLITE_PATH=./karag.db

# ---- Free local run (Ollama) --------------------------------------------
# ollama pull llama3.1 && ollama pull nomic-embed-text
# KARAG_GENERATOR=ollama
# KARAG_EMBEDDER=ollama
# KARAG_OLLAMA_URL=http://localhost:11434
# KARAG_OLLAMA_CHAT_MODEL=llama3.1
# KARAG_OLLAMA_EMBED_MODEL=nomic-embed-text
# KARAG_OLLAMA_EMBED_DIM=768

# ---- Production (Claude + pgvector) --------------------------------------
# Sonnet 5.5 at medium effort is the measured choice for the RAG agent: on
# evals/ it matched Opus 5.5 on every question at about a third of the cost
# (evals/README.md). claude-haiku-5-5 also scored the same there for a tenth
# of Sonnet's price — worth trying if cost matters more than headroom.
# KARAG_GENERATOR=anthropic
# KARAG_ANTHROPIC_MODEL=claude-sonnet-5-5
# KARAG_ANTHROPIC_EFFORT=medium        # low | medium | high | xhigh | max
# ANTHROPIC_API_KEY=sk-ant-...
# An organisation-scoped key must name its workspace on every request:
# KARAG_ANTHROPIC_WORKSPACE_ID=wrkspc_...
# Thinking counts toward this, so it is sized for thinking + the answer:
# KARAG_ANTHROPIC_MAX_TOKENS=32000
# Server-side refusal fallback: "default" lets the API re-run a declined
# benign request on the model it recommends; empty turns it off.
# KARAG_ANTHROPIC_REFUSAL_FALLBACK=default
# Fallback chain, in order, when the generator before it fails (outage, rate
# limit, bad key). A second Anthropic account can be a link of its own:
# KARAG_FALLBACK_GENERATOR=openai                 # or: anthropic_backup,openai
# KARAG_BACKUP_ANTHROPIC_API_KEY=sk-ant-...
# KARAG_BACKUP_ANTHROPIC_MODEL=claude-sonnet-5-5
# KARAG_BACKUP_ANTHROPIC_WORKSPACE_ID=
# KARAG_EMBEDDER=openai            # or voyage / ollama
# KARAG_STORE=pgvector
# KARAG_PG_DSN=postgresql://user:pass@host/karag

# ---- Scanned PDFs --------------------------------------------------------
# A PDF without a text layer is read page by page by Claude (the whole file
# goes to the API). auto = on when an Anthropic key is set; off = such an
# upload is refused with a reason instead.
# KARAG_PDF_OCR=auto
# KARAG_OCR_MODEL=claude-haiku-5-5

# ---- Cost control --------------------------------------------------------
# Monthly model budget per tenant, USD (a platform operator can set one per
# tenant on the Admin page; that wins). Empty = no cap.
# KARAG_TENANT_MONTHLY_BUDGET_USD=200
# Questions per user per minute (sliding window); 0 = unlimited.
# KARAG_RATE_LIMIT_PER_MINUTE=30

# ---- Retrieval ----------------------------------------------------------
KARAG_TOP_K=5
KARAG_MAX_ITERATIONS=4

# ---- Application database ----------------------------------------------
# Tenants, accounts, connectors, authored skills, assistants, alert rules and
# the audit trail. "memory" loses all of it on restart — use sqlite (or point
# at Postgres in production) for anything beyond a demo.
KARAG_APP_STORE=sqlite
KARAG_APP_DB=./karag_app.db

# ---- Answer language ----------------------------------------------------
# Kept for compatibility only: the answer always follows the language of the
# question now. Any value here is accepted and ignored.
# Deployment-wide default; a tenant, an account, an assistant or a single
# request can each override it. "auto" mirrors the user's own language.
KARAG_LANGUAGE=auto

# ---- Token pricing (usage & cost dashboard) -----------------------------
# USD per 1M tokens: model:input:output, comma-separated. Overrides the
# built-in defaults; an unpriced model is reported as such, never guessed.
# KARAG_PRICING=claude-sonnet-5-5:2.0:10.0,gpt-5.5:1.25:10.0

# ---- Alert scheduler (scripts/run_scheduler.py) -------------------------
# KARAG_SCHEDULER_TICK_S=30
# KARAG_ALERT_TELEGRAM_TOKEN=123456:ABC...
# KARAG_ALERT_TELEGRAM_CHAT=123456789
# KARAG_ALERT_WEBHOOK_URL=https://hooks.example.com/karag

# ---- Demo auth tokens (dev only) ----------------------------------------
# token:tenant:user:role1|role2
# Real users are onboarded through POST /v1/accounts instead, which stores only
# a hash of each token; these static entries are for local runs and bots.
# Roles: employee hr finance legal qa skill_author admin ceo platform_admin
#        karag_engineer (may propose source changes — grant deliberately)
KARAG_TOKENS=tkn_ceo:koinoti:ceo1:ceo,tkn_hr:koinoti:hr1:hr,tkn_fin:koinoti:fin1:finance,tkn_emp:koinoti:emp1:employee,tkn_ops:kit:ops1:platform_admin,tkn_eng:kit:eng1:karag_engineer

# ---- Inbound messenger bots (Telegram / WhatsApp) -----------------------
# Map a chat sender to a KARAG identity (fail-closed: unlisted senders get no
# access).
# Format: platform:sender_id:tenant:user:role1|role2[:assistant_id[:language]]
# KARAG_MESSENGER_SENDERS=telegram:12345:koinoti:ceo1:ceo,whatsapp:15551112222:koinoti:hr1:hr:asst_help:tg
# Optional Telegram webhook shared secret (set the same value when you call
# setWebhook with secret_token); rejects spoofed callbacks when set.
# KARAG_TELEGRAM_WEBHOOK_SECRET=change-me
# WhatsApp Cloud API webhook verification token (GET handshake).
# KARAG_WHATSAPP_VERIFY_TOKEN=change-me

# ---- Platform self-knowledge --------------------------------------------
# Give the assistant its own handbook + the caller's role guide, and let it
# read its own source to answer implementation questions. Set to 0 to disable.
KARAG_SELF_KNOWLEDGE=1
KARAG_REPO_ROOT=.

# ---- Guarded self-modification ------------------------------------------
# A karag_engineer can have the assistant propose source changes: written to a
# git branch, tested, and held for human review. Needs a git repository.
# Set KARAG_ENGINEER_ENABLED=0 to remove the capability entirely.
KARAG_ENGINEER_ENABLED=1
KARAG_ENGINEER_MODEL=claude-opus-5-5

# ---- Open internet (points outward — off unless set) --------------------
# Search provider: none | brave | tavily | serper
#   Brave  https://brave.com/search/api/   -> BRAVE_API_KEY
#   Tavily https://tavily.com/             -> TAVILY_API_KEY
#   Serper https://serper.dev/             -> SERPER_API_KEY
KARAG_WEB_SEARCH=none
BRAVE_API_KEY=
# Page reading: auto (follows search) | 1 (on by itself) | 0 (off)
KARAG_WEB_FETCH=auto
# Optional guards, comma-separated. Empty allow-list = anywhere public.
KARAG_WEB_ALLOW_HOSTS=
KARAG_WEB_DENY_HOSTS=
# Internal hosts cleared by name. Everything else must resolve to a public
# address, so this is the only way to point a data source at an intranet API
# (or at the testbench double: KARAG_WEB_ALLOW_PRIVATE_HOSTS=karag-test-api).
KARAG_WEB_ALLOW_PRIVATE_HOSTS=
# Roles allowed to use the web; empty = everyone who can chat.
KARAG_WEB_ROLES=

# --- retrieval hygiene (2026-09) ------------------------------------------
# Chunks scoring below this cosine similarity are not shown to the model.
# 0 keeps everything non-negative; ~0.2 is a sensible floor for OpenAI/Voyage
# embeddings, which score unrelated text around 0.1.
KARAG_MIN_SCORE=0
# At most this many chunks of one document per answer, so one long document
# cannot crowd every other source out of the context.
KARAG_MAX_PER_DOCUMENT=2
# A skill (SQL, REST, procedure, file) that has not answered by then is
# reported to the model as failed instead of hanging the turn.
KARAG_SKILL_TIMEOUT=60
# hybrid = vector + keyword (BM25) search fused; dense = vector only. Keyword
# search is what finds codes (АМК-875), form numbers, names and streets.
KARAG_RETRIEVAL_MODE=hybrid
# Show a passage only if its similarity is at least this share of the best
# passage's (a strong keyword match is kept regardless). 0.8 cut the passages
# from the wrong documents from ~3 to ~1 per question in evals/; 0 disables.
KARAG_RELATIVE_FLOOR=0.8
# Chunk by section and embed each passage with its title and heading.
KARAG_CONTEXTUAL_CHUNKS=1
# Offer the model a search_documents tool to look again with better words.
KARAG_AGENTIC_SEARCH=1

# --- guided integrations (2026-09) -----------------------------------------
# Where uploaded database files (.sqlite / .db / imported .sql dumps) are kept.
KARAG_UPLOAD_DIR=./data/uploads
# Set this and database passwords / DSNs typed into the console are encrypted
# at rest (Fernet, needs `pip install cryptography`). Any long random string.
# Without it they are stored as typed and only ever served back redacted.
# KARAG_SECRET_KEY=change-me-to-a-long-random-string
